<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign tools = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in tools %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 text-center date-column">
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if content.preview %}
                    {% if content.preview contains '://' %}
                      <img class="preview z-depth-1 rounded" src="{{ content.preview }}">
                    {% else %}
                      {% assign preview_path = content.preview | prepend: '/assets/img/publication_preview/' %}
                      {%
                        include figure.liquid
                        loading="eager"
                        path=preview_path
                        sizes = "400px"
                        class="preview z-depth-1 rounded"
                        zoomable=true
                        avoid_scaling=true
                        alt=content.preview
                      %}
                    {% endif %}
                  {% else %}
                    {% assign preview_path = '/assets/img/publication_preview/devtools.jpg' %}
                    {%
                      include figure.liquid
                      loading="eager"
                      path=preview_path
                      sizes = "400px"
                      class="preview z-depth-1 rounded"
                      zoomable=true
                      avoid_scaling=true
                      alt=content.preview
                    %}
                  {% endif %}
                  </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.name }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.publisher }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
